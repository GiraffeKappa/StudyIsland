# Supabase project URL; browser clients do not connect to Supabase directly.
NEXT_PUBLIC_SUPABASE_URL=
# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Passwordless family links: two DIFFERENT random secrets of at least 32 characters.
# Never prefix these with NEXT_PUBLIC_. Keep their values out of Git and logs.
STUDENT_ACCESS_KEY=
PARENT_ACCESS_KEY=
# Primary AI provider: Gemini. Choose an enabled structured-output model in your account.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional comma-separated model allowlist for parent settings. Defaults to GEMINI_MODEL.
AI_ALLOWED_MODELS=
# Application-side daily request count; NOT a provider billing hard cap.
AI_DAILY_REQUEST_LIMIT=30
# Local demo available only in development when Supabase is absent. Always disabled in production.
ALLOW_LOCAL_DEMO=true
# Canonical origin in production, e.g. https://your-private-app.example
SITE_ORIGIN=
